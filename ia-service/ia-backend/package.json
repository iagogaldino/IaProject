{
  "name": "ai-backend",
  "version": "1.0.0",
  "description": "Backend dedicado para processamento de IA e agentes inteligentes",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --legacy-watch --exec ts-node src/index.ts",
    "debug": "node debug-server.js",
    "debug:attach": "node --inspect-brk=9229 dist/index.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test:compile": "node scripts/test-compilation.js",
    "test:quick": "node scripts/quick-test.js",
    "test:mongodb": "node scripts/test-mongodb.js",
    "test:mongodb:connection": "node scripts/test-mongodb-connection.js",
    "setup:database": "node scripts/setup-database.js",
    "test:endpoints": "node scripts/test-endpoints.js",
    "check:env": "node scripts/check-env.js",
    "check": "npm run test:compile && npm run lint"
  },
  "keywords": [
    "ai",
    "agents",
    "openai",
    "typescript",
    "nodejs"
  ],
  "author": "IaProject Team",
  "license": "MIT",
  "dependencies": {
    "@types/multer": "^2.0.0",
    "@types/xlsx": "^0.0.35",
    "axios": "^1.6.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "form-data": "^4.0.4",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "mammoth": "^1.11.0",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "openai": "^5.13.1",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.30",
    "@types/sharp": "^0.31.1",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}