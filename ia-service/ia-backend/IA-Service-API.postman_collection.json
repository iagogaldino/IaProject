{
  "info": {
    "name": "IA Service API",
    "description": "Collection para testar a API do IA Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "your-api-key-for-external-access",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Get Health Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Verifica o status geral da aplicação"
          },
          "response": []
        },
        {
          "name": "Get Health Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/metrics",
              "host": ["{{baseUrl}}"],
              "path": ["health", "metrics"]
            },
            "description": "Obtém métricas da aplicação"
          },
          "response": []
        },
        {
          "name": "Get Config Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/config",
              "host": ["{{baseUrl}}"],
              "path": ["health", "config"]
            },
            "description": "Verifica o status da configuração"
          },
          "response": []
        }
      ],
      "description": "Endpoints para verificação de saúde da API"
    },
    {
      "name": "AI Processing",
      "item": [
        {
          "name": "Process AI Request (Public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Olá, como você está?\",\n  \"context\": \"teste de conversa\",\n  \"userId\": \"user123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ai/process",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ai", "process"]
            },
            "description": "Processamento de IA sem autenticação"
          },
          "response": []
        },
        {
          "name": "Process AI Request (Alternative)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Explique sobre inteligência artificial\",\n  \"context\": \"educação\",\n  \"userId\": \"user456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/process",
              "host": ["{{baseUrl}}"],
              "path": ["process"]
            },
            "description": "Processamento alternativo de IA (autenticação opcional)"
          },
          "response": []
        }
      ],
      "description": "Endpoints para processamento de IA"
    },
    {
      "name": "Agents",
      "item": [
        {
          "name": "Get All Agents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/agents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "agents"]
            },
            "description": "Lista todos os agentes"
          },
          "response": []
        },
        {
          "name": "Get Active Agents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/agents/active",
              "host": ["{{baseUrl}}"],
              "path": ["api", "agents", "active"]
            },
            "description": "Lista apenas agentes ativos"
          },
          "response": []
        },
        {
          "name": "Get Agent by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/agents/{{agentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "agents", "{{agentId}}"]
            },
            "description": "Obtém um agente específico por ID"
          },
          "response": []
        },
        {
          "name": "Create Agent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Agente Teste\",\n  \"description\": \"Agente para testes da API\",\n  \"type\": \"assistant\",\n  \"status\": \"active\",\n  \"configuration\": {\n    \"model\": \"gpt-3.5-turbo\",\n    \"temperature\": 0.7,\n    \"maxTokens\": 2000\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/agents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "agents"]
            },
            "description": "Cria um novo agente"
          },
          "response": []
        },
        {
          "name": "Update Agent",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Agente Atualizado\",\n  \"description\": \"Descrição atualizada do agente\",\n  \"type\": \"assistant\",\n  \"configuration\": {\n    \"model\": \"gpt-4\",\n    \"temperature\": 0.5,\n    \"maxTokens\": 3000\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/agents/{{agentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "agents", "{{agentId}}"]
            },
            "description": "Atualiza um agente existente"
          },
          "response": []
        },
        {
          "name": "Update Agent Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"inactive\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/agents/{{agentId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "agents", "{{agentId}}", "status"]
            },
            "description": "Atualiza apenas o status de um agente"
          },
          "response": []
        },
        {
          "name": "Delete Agent",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/agents/{{agentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "agents", "{{agentId}}"]
            },
            "description": "Remove um agente"
          },
          "response": []
        }
      ],
      "description": "Endpoints para gerenciamento de agentes"
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "Chat with Agent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Olá agente, como você pode me ajudar hoje?\",\n  \"context\": \"conversa inicial\",\n  \"userId\": \"user123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/agents/{{agentId}}/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "agents", "{{agentId}}", "chat"]
            },
            "description": "Conversa com um agente específico"
          },
          "response": []
        },
        {
          "name": "Chat with Agent - Technical Question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Explique como funciona o machine learning em termos simples\",\n  \"context\": \"educação técnica\",\n  \"userId\": \"user456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/agents/{{agentId}}/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "agents", "{{agentId}}", "chat"]
            },
            "description": "Exemplo de pergunta técnica para o agente"
          },
          "response": []
        }
      ],
      "description": "Endpoints para conversação com agentes"
    },
    {
      "name": "Test Scenarios",
      "item": [
        {
          "name": "Complete Agent Workflow",
          "item": [
            {
              "name": "1. Create Agent",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "X-API-Key",
                    "value": "{{apiKey}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Agente de Suporte\",\n  \"description\": \"Agente especializado em atendimento ao cliente\",\n  \"type\": \"customer_service\",\n  \"status\": \"active\",\n  \"configuration\": {\n    \"model\": \"gpt-3.5-turbo\",\n    \"temperature\": 0.3,\n    \"maxTokens\": 1500\n  }\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/agents",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "agents"]
                },
                "description": "Cria um agente para o fluxo de teste"
              },
              "response": []
            },
            {
              "name": "2. Get All Agents",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "X-API-Key",
                    "value": "{{apiKey}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/agents",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "agents"]
                },
                "description": "Verifica se o agente foi criado"
              },
              "response": []
            },
            {
              "name": "3. Chat with Agent",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "X-API-Key",
                    "value": "{{apiKey}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"message\": \"Preciso de ajuda com um problema técnico\",\n  \"context\": \"suporte técnico\",\n  \"userId\": \"customer123\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/agents/{{agentId}}/chat",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "agents", "{{agentId}}", "chat"]
                },
                "description": "Testa a conversa com o agente criado"
              },
              "response": []
            },
            {
              "name": "4. Update Agent Status",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Content-Type",
                "value": "application/json"
                  },
                  {
                    "key": "X-API-Key",
                    "value": "{{apiKey}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"inactive\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/agents/{{agentId}}/status",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "agents", "{{agentId}}", "status"]
                },
                "description": "Desativa o agente"
              },
              "response": []
            },
            {
              "name": "5. Delete Agent",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "X-API-Key",
                    "value": "{{apiKey}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/agents/{{agentId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "agents", "{{agentId}}"]
                },
                "description": "Remove o agente de teste"
              },
              "response": []
            }
          ],
          "description": "Fluxo completo de teste de um agente"
        }
      ],
      "description": "Cenários de teste completos"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Log da requisição",
          "console.log('Making request to:', pm.request.url.toString());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Testes básicos de resposta",
          "pm.test('Status code is successful', function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
          "});",
          "",
          "pm.test('Response time is less than 5000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "",
          "// Salvar agentId se presente na resposta",
          "if (pm.response.json() && pm.response.json().data && pm.response.json().data._id) {",
          "    pm.collectionVariables.set('agentId', pm.response.json().data._id);",
          "    console.log('Agent ID saved:', pm.response.json().data._id);",
          "}"
        ]
      }
    }
  ]
}
