# Configuração do AI Backend - Sistema de Agentes Inteligentes

# Configuração do Servidor
PORT=3001
NODE_ENV=development
API_VERSION=v1

# Configuração do Banco de Dados MongoDB
DB_HOST=localhost
DB_PORT=27017
DB_NAME=ai_backend
DB_USER=
DB_PASSWORD=
DB_SSL=false
MONGODB_URI=mongodb://localhost:27017/ai_backend
DATABASE_URL=mongodb://localhost:27017/ai_backend

# Configuração da OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Configuração de Autenticação
API_KEY=your-secure-api-key-here

# Configuração de Segurança
JWT_SECRET=your-jwt-secret-here

# Configuração de Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configuração de CORS
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# Configuração de Logs
LOG_LEVEL=info
LOG_FILE=logs/combined.log

# Configuração de Serviços Externos
MAIN_BACKEND_URL=http://localhost:3000
EXTERNAL_SERVICES_TIMEOUT=30000
EXTERNAL_SERVICES_RETRIES=3

# Configuração da API Externa de Extração de Dados
EXTERNAL_EXTRACTOR_API_URL=http://localhost:3000/api/extract
EXTERNAL_EXTRACTOR_TIMEOUT=30000

# Configuração de Monitoramento
ENABLE_METRICS=true
METRICS_PORT=9090
