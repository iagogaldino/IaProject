        "type": "text/javascript",
        "exec": [
          "// Auto-add headers for authenticated endpoints",
          "const url = pm.request.url.toString();",
          "const method = pm.request.method;",
          "",
          "// Skip health endpoints and public AI processing",
          "if (url.includes('/health') || url.includes('/api/ai/process')) {",
          "    return;",
          "}",
          "",
          "// Add Content-Type for POST, PUT, PATCH requests",
          "if (['POST', 'PUT', 'PATCH'].includes(method)) {",
          "    pm.request.headers.add({",
          "        key: 'Content-Type',",
          "        value: 'application/json'",
          "    });",
          "}",
          "",
          "// Add X-API-Key for all authenticated endpoints",
          "pm.request.headers.add({",
          "    key: 'X-API-Key',",
          "    value: 'ai-backend-2024-abc123xyz789'",
          "});"
        ]
      }
