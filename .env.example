# ===========================================
# CONFIGURAÇÃO DO PROJETO IA PROJECT
# ===========================================
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para .env
# 2. Preencha as credenciais reais
# 3. NUNCA commite o arquivo .env no Git
#
# ===========================================

# ===========================================
# OPENAI API CONFIGURATION
# ===========================================
# Sua chave da API da OpenAI
# Obtenha em: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-proj-SUA_CHAVE_OPENAI_AQUI

# ===========================================
# MONGODB CONFIGURATION
# ===========================================
# Credenciais do MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=SUA_SENHA_MONGODB_AQUI
MONGO_INITDB_DATABASE=db-ia

# Configuração de conexão com o banco
DB_HOST=mongodb
DB_PORT=27017
DB_NAME=db-ia
DB_USER=admin
DB_PASSWORD=SUA_SENHA_MONGODB_AQUI
DB_SSL=false
MONGODB_URI=mongodb://admin:SUA_SENHA_MONGODB_AQUI@mongodb:27017/db-ia?authSource=admin

# ===========================================
# API KEYS & AUTHENTICATION
# ===========================================
# Chaves de autenticação para comunicação entre serviços
API_KEY=SUA_API_KEY_AQUI
AI_API_KEY=SUA_AI_API_KEY_AQUI
AI_AGENT_ID=SEU_AGENT_ID_AQUI

# ===========================================
# MONGO EXPRESS CONFIGURATION
# ===========================================
# Interface web para gerenciar o MongoDB
ME_CONFIG_MONGODB_ADMINUSERNAME=admin
ME_CONFIG_MONGODB_ADMINPASSWORD=SUA_SENHA_MONGODB_AQUI
ME_CONFIG_MONGODB_URL=mongodb://admin:SUA_SENHA_MONGODB_AQUI@mongodb:27017/
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=SUA_SENHA_MONGO_EXPRESS_AQUI

# ===========================================
# OPTIONAL CONFIGURATIONS
# ===========================================
# Configurações opcionais (podem ser mantidas como padrão)

# OpenAI Model Configuration
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Security
JWT_SECRET=SEU_JWT_SECRET_AQUI

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/combined.log

# External Services
MAIN_BACKEND_URL=http://localhost:3000
EXTERNAL_SERVICES_TIMEOUT=30000
EXTERNAL_SERVICES_RETRIES=3
EXTERNAL_EXTRACTOR_API_URL=http://localhost:3000/api/extract
EXTERNAL_EXTRACTOR_TIMEOUT=30000

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# ===========================================
# INSTRUÇÕES DE USO
# ===========================================
# 
# 1. DESENVOLVIMENTO LOCAL:
#    - Copie este arquivo para .env
#    - Preencha as credenciais reais
#    - Execute: docker-compose -f docker-compose.yml -f docker-compose.dev.yml up -d
#
# 2. PRODUÇÃO:
#    - Configure as variáveis de ambiente no servidor
#    - Execute: docker-compose up -d
#
# 3. SEGURANÇA:
#    - NUNCA commite o arquivo .env
#    - Use senhas fortes e únicas
#    - Rotacione as chaves regularmente
#
# ===========================================
